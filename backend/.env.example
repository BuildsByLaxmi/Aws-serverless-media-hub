# Copy to backend/.env (git-ignored). Get values: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # "service_role" secret. NEVER put in frontend or commit.
WORKER_TRIGGER_TOKEN=                 # any long random string; protects POST /internal/process/{id}
PROCESS_INLINE=false                  # true = API processes after upload (no separate worker needed)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:5500
MAX_INPUT_MB=50
